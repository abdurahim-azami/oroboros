{"code":"27-2031.00","title":"Dancers","description":"Perform dances. May perform on stage, for broadcasting, or for video recording.","zone":3,"aioe_pct":0.0,"aei_observed":0.0,"tasks":[{"id":21141,"text":"Prepare pointe shoes, by sewing or other means, for use in rehearsals and performance.","type":"Supplemental","updated":"08/2019","im":4.69,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1059,1061]},{"id":7686,"text":"Study and practice dance moves required in roles.","type":"Core","updated":"08/2019","im":4.51,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[894]},{"id":7687,"text":"Harmonize body movements to rhythm of musical accompaniment.","type":"Core","updated":"08/2019","im":4.37,"cap":"speech","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1723]},{"id":7685,"text":"Train, exercise, and attend dance classes to maintain high levels of technical proficiency, physical ability, and physical fitness.","type":"Core","updated":"08/2019","im":4.29,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[894]},{"id":7697,"text":"Perform in productions, singing or acting in addition to dancing, if required.","type":"Supplemental","updated":"08/2019","im":4.27,"cap":"speech","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1722]},{"id":7690,"text":"Coordinate dancing with that of partners or dance ensembles.","type":"Core","updated":"08/2019","im":4.26,"cap":"speech","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1723]},{"id":7688,"text":"Perform classical, modern, or acrobatic dances in productions, expressing stories, rhythm, and sound with their bodies.","type":"Core"