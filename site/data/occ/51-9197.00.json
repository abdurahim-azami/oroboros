{"code":"51-9197.00","title":"Tire Builders","description":"Operate machines to build tires.","zone":2,"aioe_pct":0.044,"aei_observed":0.0,"tasks":[{"id":14431,"text":"Place tires into molds for new tread.","type":"Supplemental","updated":"08/2020","im":4.85,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1065]},{"id":14423,"text":"Fit inner tubes and final layers of rubber onto tires.","type":"Supplemental","updated":"08/2020","im":4.82,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[969]},{"id":21215,"text":"Buff tires according to specifications for width and undertread depth.","type":"Supplemental","updated":"08/2020","im":4.72,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1130]},{"id":14418,"text":"Build semi-raw rubber treads onto buffed tire casings to prepare tires for vulcanization in recapping or retreading processes.","type":"Core","updated":"08/2020","im":4.6,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[969]},{"id":14426,"text":"Brush or spray solvents onto plies to ensure adhesion, and repeat process as specified, alternating direction of each ply to strengthen tires.","type":"Supplemental","updated":"08/2020","im":4.59,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[947]},{"id":14411,"text":"Start rollers that bond tread and plies as drums revolve.","type":"Supplemental","updated":"08/2020","im":4.57,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[969]},{"id":14415,"text":"Align treads with guides, start drums to wind treads onto plies, and slice ends.","type":"Supplemental","updated":"08/2020","im":4.56,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[994,1106]},{"id":14413,"text":"Inspect worn tires for faults, cracks, cuts, and nail holes, and to determine if tires are suitable for retreading.","type":"Supplemental","updated":"08/2020","im":4.54,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[260]},{"id":14428,"text":"Measure tires to determine mold size requirements.","type":"Supplemental","updated":"08/2020","im":4.52,"cap":"data","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.0,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[337]},{"id":14430,"text":"Trim excess rubber and imperfections during retreading processes.","type":"Core","updated":"08/2020","im":4.47,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1104]},{"id":14427,"text":"Roll hand rollers over rebuilt casings, exerting pressure to ensure adhesion between camelbacks and casings.","type":"Supplemental","updated":"08/2020","im":4.4,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[969]},{"id":14425,"text":"Fill cuts and holes in tires, using hot rubber.","type":"Core","updated":"08/2020","im":4.39,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[986]},{"id":14417,"text":"Position ply stitcher rollers and drums according to width of stock, using hand tools and gauges.","type":"Supplemental","updated":"08/2020","im":4.37,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1064]},{"id":14414,"text":"Cut plies at splice points, and press ends together to form continuous bands.","type":"Supplemental","updated":"08/2020","im":4.36,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1106]},{"id":14410,"text":"Depress pedals to rotate drums, and wind specified numbers of plies around drums to form tire bodies.","type":"Supplemental","updated":"08/2020","im":4.31,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[969]},{"id":14422,"text":"Clean and paint completed tires.","type":"Supplemental","updated":"08/2020","im":4.27,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[849,945]},{"id":14424,"text":"Rub cement sticks on drum edges to provide adhesive surfaces for plies.","type":"Supplemental","updated":"08/2020","im":4.14,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[947]},{"id":14429,"text":"Depress pedals to collapse drums after processing is complete.","type":"Supplemental","updated":"08/2020","im":4.03,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[969]},{"id":14419,"text":"Wind chafers and breakers onto plies.","type":"Supplemental","updated":"08/2020","im":3.96,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[824]},{"id":14420,"text":"Pull plies from supply racks, and align plies with edges of drums.","type":"Supplemental","updated":"08/2020","im":3.45,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[994]}],"emerging":[]}