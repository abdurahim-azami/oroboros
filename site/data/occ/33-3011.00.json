{"code":"33-3011.00","title":"Bailiffs","description":"Maintain order in courts of law.","zone":3,"aioe_pct":0.383,"aei_observed":0.0,"tasks":[{"id":20123,"text":"Screen persons entering courthouse using magnetometers, x-ray machines, and other devices to collect and retain unauthorized firearms and other contraband.","type":"Core","updated":"08/2020","im":4.7,"cap":"vision","capMethod":"keyword","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[878,868]},{"id":20127,"text":"Escort prisoners to and from courthouse and maintain custody of prisoners during court proceedings.","type":"Core","updated":"08/2020","im":4.6,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[883]},{"id":2091,"text":"Maintain order in courtroom during trial and guard jury from outside contact.","type":"Core","updated":"08/2020","im":4.46,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[872,874]},{"id":20124,"text":"Provide security by patrolling interior and exterior of courthouse and escorting judges and other court employees.","type":"Core","updated":"08/2020","im":4.44,"cap":"data","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[176,872]},{"id":2092,"text":"Guard lodging of sequestered jury.","type":"Core","updated":"08/2020","im":4.4,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[875]},{"id":2094,"text":"Enforce courtroom rules of behavior and warn persons not to smoke or disturb court procedure.","type":"Core","updated":"08/2020","im":4.39,"cap":"writing","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.5,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[1561,874]},{"id":21197,"text":"Arrest persons in court when arrest warrants have been issued.","type":"Core","