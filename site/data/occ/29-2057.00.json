{"code":"29-2057.00","title":"Ophthalmic Medical Technicians","description":"Assist ophthalmologists by performing ophthalmic clinical functions. May administer eye exams, administer eye medications, and instruct the patient in care and use of corrective lenses.","zone":3,"aioe_pct":0.534,"aei_observed":0.0,"tasks":[{"id":19252,"text":"Take and document patients' medical histories.","type":"Core","updated":"08/2020","im":4.95,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":1.0,"human":0.5,"aei":0.724},"low":0.25,"high":0.5,"imputed":false,"dwas":[58,1454]},{"id":19250,"text":"Operate ophthalmic equipment, such as autorefractors, phoropters, tomographs, or retinoscopes.","type":"Core","updated":"08/2020","im":4.91,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.0,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[222]},{"id":19257,"text":"Conduct tonometry or tonography tests to measure intraocular pressure.","type":"Core","updated":"08/2020","im":4.91,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[222]},{"id":19249,"text":"Measure visual acuity, including near, distance, pinhole, or dynamic visual acuity, using appropriate tests.","type":"Core","updated":"08/2020","im":4.9,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.0,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[222]},{"id":19251,"text":"Take anatomical or functional ocular measurements of the eye or surrounding tissue, such as axial length measurements.","type":"Core","updated":"08/2020","im":4.9,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.5,"aei":null},"low":0.25,"high":0.25,"imputed":false,"dwas":[304]},{"id":19248,"text":"Measure and record lens power, using lensometers.","type":"Core","updated":"08/2020","im":4.86,"cap":"doc","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.5,"aei":null},"low":0.25,"high":0.25,"imputed":false,"dwas":[1454,1188]},{"id":19239,