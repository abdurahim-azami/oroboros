{"code":"41-2022.00","title":"Parts Salespersons","description":"Sell spare and replacement parts and equipment in repair shop or parts store.","zone":2,"aioe_pct":0.488,"aei_observed":0.0,"tasks":[{"id":2430,"text":"Receive payment or obtain credit authorization.","type":"Core","updated":"08/2023","im":4.71,"cap":"agents","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.5,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[2020]},{"id":20776,"text":"Assist customers, such as responding to customer complaints and updating them about back-ordered parts.","type":"Core","updated":"08/2023","im":4.64,"cap":"writing","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":1.0,"aei":null},"low":0.25,"high":0.5,"imputed":false,"dwas":[1494]},{"id":20775,"text":"Fill customer orders from stock, and place orders when requested items are out of stock.","type":"Core","updated":"08/2023","im":4.59,"cap":"data","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.0,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[2070,2020]},{"id":2427,"text":"Receive and fill telephone orders for parts.","type":"Core","updated":"08/2023","im":4.56,"cap":"speech","capMethod":"keyword","e":{"gpt4":0.5,"human":1.0,"aei":null},"low":0.25,"high":0.5,"imputed":false,"dwas":[2019,2020]},{"id":20777,"text":"Locate and label parts, and maintain inventory of stock.","type":"Core","updated":"08/2023","im":4.55,"cap":"data","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[2085]},{"id":2429,"text":"Prepare sales slips or sales contracts.","type":"Core","updated":"08/2023","im":4.48,"cap":"doc","capMethod":"gwa_vote","e":{"gpt4":1.0,"human":1.0,"aei":null},"low":0.5,"high":0.5,"imputed":false,"dwas":[1466]},{"id":2425,"text":"Read catalogs, microfiche viewers, or computer displays to determine replacement part stock numbers and prices.","type":"Core","updated":"08/2023","im":4.43,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":1.0,"human":0.0,"aei":null},"low":0.0,"high":0.5,"imputed":false,"dwas":[65]},{"id":2426,"text":"Determine replacement parts required, according to inspections of old parts, customer requests, or customers' descriptions of malfunctions.","type":"Core","updated":"08/2023","im":4.4,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.0,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[65]},{"id":2433,"text":"Examine returned parts for defects, and exchange defective parts or refund money.","type":"Core","updated":"08/2023","im":4.28,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[312,2020]},{"id":20780,"text":"Manage shipments by researching shipping methods or costs and tracking packages.","type":"Core","updated":"08/2023","im":4.25,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.5,"aei":null},"low":0.25,"high":0.25,"imputed":false,"dwas":[534,496]},{"id":2434,"text":"Mark and store parts in stockrooms, according to prearranged systems.","type":"Core","updated":"08/2023","im":4.22,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[972]},{"id":20779,"text":"Maintain and clean work and inventory areas.","type":"Core","updated":"08/2023","im":4.14,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[807]},{"id":2437,"text":"Place new merchandise on display.","type":"Core","updated":"08/2023","im":4.09,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1076]},{"id":2432,"text":"Advise customers on substitution or modification of parts when identical replacements are not available.","type":"Core","updated":"08/2023","im":4.03,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":1.0,"aei":null},"low":0.25,"high":0.5,"imputed":false,"dwas":[1952]},{"id