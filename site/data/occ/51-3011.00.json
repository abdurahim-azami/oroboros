{"code":"51-3011.00","title":"Bakers","description":"Mix and bake ingredients to produce breads, rolls, cookies, cakes, pies, pastries, or other baked goods.","zone":2,"aioe_pct":0.414,"aei_observed":0.0,"tasks":[{"id":11918,"text":"Measure or weigh flour or other ingredients to prepare batters, doughs, fillings, or icings, using scales or graduated containers.","type":"Core","updated":"08/2026","im":4.62,"cap":"data","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[327]},{"id":11916,"text":"Set oven temperatures, and place items into hot ovens for baking.","type":"Core","updated":"08/2026","im":4.47,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1094]},{"id":11924,"text":"Check equipment to ensure that it meets health and safety regulations, and perform maintenance or cleaning, as necessary.","type":"Core","updated":"08/2026","im":4.46,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1358,120,801]},{"id":20819,"text":"Check products for quality, and identify damaged or expired goods.","type":"Core","updated":"08/2026","im":4.46,"cap":"data","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.0,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[384]},{"id":11922,"text":"Adapt the quantity of ingredients to match the amount of items to be baked.","type":"Core","updated":"08/2026","im":4.43,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":1.0,"human":1.0,"aei":null},"low":0.5,"high":0.5,"imputed":false,"dwas":[553]},{"id":11920,"text":"Place dough in pans, molds, or on sheets, and bake in production ovens or on grills.","type":"Core","updated":"08/2026","im":4.42,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1206]},{"id":11915,"text":"Observe color of products being baked, a