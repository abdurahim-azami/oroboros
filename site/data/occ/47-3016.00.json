{"code":"47-3016.00","title":"Helpers--Roofers","description":"Help roofers by performing duties requiring less skill. Duties include using, supplying, or holding materials or tools, and cleaning work area and equipment.","zone":2,"aioe_pct":0.01,"aei_observed":0.0,"tasks":[{"id":14926,"text":"Check to ensure that completed roofs are watertight.","type":"Core","updated":"08/2026","im":4.51,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[266]},{"id":14934,"text":"Set ladders, scaffolds, and hoists in place for taking supplies to roofs.","type":"Core","updated":"08/2026","im":4.37,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[922]},{"id":14929,"text":"Clean work areas and equipment.","type":"Core","updated":"08/2026","im":4.34,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[792,798]},{"id":14930,"text":"Maintain tools and equipment.","type":"Core","updated":"08/2026","im":4.28,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1352]},{"id":14936,"text":"Provide assistance to skilled roofers installing and repairing roofs, flashings, and surfaces.","type":"Core","updated":"08/2026","im":4.24,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[842]},{"id":14928,"text":"Locate worn or torn areas in roofs.","type":"Core","updated":"08/2026","im":4.22,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[280]},{"id":14927,"text":"Sweep and clean roofs to prepare them for the application of new roofing materials.","type":"Core","updated":"08/2026","im":4.14,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[800]},{"id":14932,"text":"Remove old roofing materials.","type":"Core","updated":"08/2026","im":4.12,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[818]},{"id":14938,"text":"Perform emergency leak repairs and general maintenance for a variety of roof types.","type":"Core","updated":"08/2026","im":4.08,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[909]},{"id":14933,"text":"Unload materials and tools from work trucks, and unroll roofing as directed.","type":"Core","updated":"08/2026","im":3.98,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[828]},{"id":14940,"text":"Hoist tar and roofing materials to roofs, using ropes and pulleys, or carry materials up ladders.","type":"Core","updated":"08/2026","im":3.91,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[856]},{"id":14943,"text":"Clear drains and downspouts and clean gutters.","type":"Core","updated":"08/2026","im":3.89,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[792]},{"id":14931,"text":"Cover roofs with layers of roofing felt or asphalt strips before installing tile, slate, or composition materials.","type":"Core","updated":"08/2026","im":3.84,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[909]},{"id":14939,"text":"Attach sheets of metal to roof boards or building frameworks when installing metal roofs.","type":"Core","updated":"08/2026","im":3.71,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[909]},{"id":14941,"text":"Apply shingles, gravel, or asphalt over the top layer of tar to protect the roofing material.","type":"Core","updated":"08/2026","im":3.62,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[840,909]},{"id":14935,"text":"Place tiles, nail them to roof boards, and cover nailheads with roofing cement.","type":"Supplemental","updated":"08/2026","im":3.53,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[909,948]},{"id":14942,"text":"Chop tar into small pieces, and heat chopped tar in kettles.","type":"Core","updated":"08/2026","im":3.36,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[780]},{"id":14937,"text":"Attach roofing paper and composition shingles, using nails.","type":"Core","updated":"08/2026","im":3.24,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[909]}],"emerging":[]}