{"code":"53-3051.00","title":"Bus Drivers, School","description":"Drive a school bus to transport students. Ensure adherence to safety rules. May assist students in boarding or exiting.","zone":2,"aioe_pct":null,"aei_observed":0.0,"tasks":[{"id":23716,"text":"Comply with traffic regulations to operate vehicles in a safe and courteous manner.","type":"Core","updated":"08/2026","im":4.98,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1240]},{"id":23719,"text":"Follow safety rules as students board and exit buses or cross streets near bus stops.","type":"Core","updated":"08/2026","im":4.94,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1240]},{"id":23715,"text":"Check the condition of a vehicle's tires, brakes, windshield wipers, lights, oil, fuel, water, and safety equipment to ensure that everything is in working order.","type":"Core","updated":"08/2026","im":4.93,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[236]},{"id":23729,"text":"Report any bus malfunctions or needed repairs.","type":"Core","updated":"08/2026","im":4.87,"cap":"writing","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.5,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[1557]},{"id":23724,"text":"Pick up and drop off students at regularly scheduled neighborhood locations, following strict time schedules.","type":"Core","updated":"08/2026","im":4.78,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1237]},{"id":23718,"text":"Escort small children across roads and highways.","type":"Core","updated":"08/2026","im":4.77,"cap":"human","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1654]},{"id":23717,"text":"Drive gasoline, diesel, o