{"code":"29-1292.00","title":"Dental Hygienists","description":"Administer oral hygiene care to patients. Assess patient oral hygiene problems or needs and maintain health records. Advise patients on oral health maintenance and disease prevention. May provide advanced care such as providing fluoride treatment or administering topical anesthesia.","zone":3,"aioe_pct":null,"aei_observed":0.0,"tasks":[{"id":18536,"text":"Record and review patient medical histories.","type":"Core","updated":"08/2021","im":4.89,"cap":"doc","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.5,"aei":0.724},"low":0.25,"high":0.362,"imputed":false,"dwas":[1454]},{"id":417,"text":"Feel and visually examine gums for sores and signs of disease.","type":"Core","updated":"08/2021","im":4.8,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[303]},{"id":416,"text":"Clean calcareous deposits, accretions, and stains from teeth and beneath margins of gums, using dental instruments.","type":"Core","updated":"08/2021","im":4.79,"cap":"human","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1675]},{"id":421,"text":"Examine gums, using probes, to locate periodontal recessed gums and signs of gum disease.","type":"Core","updated":"08/2021","im":4.79,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[303,1188]},{"id":18537,"text":"Provide clinical services or health education to improve and maintain the oral health of patients or the general public.","type":"Core","updated":"08/2021","im":4.66,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1945]},{"id":418,"text":"Chart conditions of decay and disease for diagnosis and treatment by dentist.","type":"Core","updated":"08/2021","im":4.55,"cap":"doc","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.5,"aei":null},"low":0.25,"high":0.25,"imputed":false,"dwas":[1454]},{"id":422,"text":"Expose and develop x-ray film.","type":"Core","updated":"08/2021","im":4.51,"cap":"vision","capMethod":"keyword","e":{"gpt4":0.5,"human":0.0,"aei":null},"low":0.0,"high":0.25,"imputed":false,"dwas":[1186]},{"id":23921,"text":"Attend continuing education courses to maintain or update skills.","type":"Core","updated":"08/2021","im":4.48,"cap":"research","capMethod":"gwa_vote","e":{"gpt4":1.0,"human":0.0,"aei":null},"low":0.0,"high":0.5,"imputed":false,"dwas":[729,738]},{"id":420,"text":"Apply fluorides or other cavity preventing agents to arrest dental decay.","type":"Core","updated":"08/2021","im":4.47,"cap":"human","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1675]},{"id":18538,"text":"Maintain dental equipment and sharpen and sterilize dental instruments.","type":"Core","updated":"08/2021","im":4.47,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[852,1343]},{"id":18539,"text":"Maintain patient recall system.","type":"Core","updated":"08/2021","im":4.4,"cap":"agents","capMethod":"gwa_vote","e":{"gpt4":0.5,"human":0.5,"aei":null},"low":0.25,"high":0.25,"imputed":false,"dwas":[762,761]},{"id":419,"text":"Feel lymph nodes under patient's chin to detect swelling or tenderness that could indicate presence of oral cancer.","type":"Core","updated":"08/2021","im":4.31,"cap":"vision","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[303]},{"id":427,"text":"Administer local anesthetic agents.","type":"Core","updated":"08/2021","im":3.92,"cap":"human","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1623]},{"id":424,"text":"Remove excess cement from coronal surfaces of teeth.","type":"Core","updated":"08/2021","im":3.83,"cap":"human","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1675]},{"id":428,"text":"Conduct dental health clinics for community groups to augment services of dentist.","type":"Supplemental","updated":"08/2021","im":2.98,"cap":"human","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1911]},{"id":425,"text":"Make impressions for study casts.","type":"Supplemental","updated":"08/2021","im":2.75,"cap":"robotics","capMethod":"gwa_vote","e":{"gpt4":0.0,"human":0.0,"aei":null},"low":0.0,"high":0.0,"imputed":false,"dwas":[1136]}],"emerging":[]}